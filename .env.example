# Application
APP_NAME=Agentic Business Operating Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Secret Keys (generate a strong secret key in production)
SECRET_KEY=your-secret-key-here-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://agentic_user:agentic_password@localhost:5432/agentic_platform
# Alternative for async: postgresql+asyncpg://agentic_user:agentic_password@localhost:5432/agentic_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Email Configuration (optional, for email authentication)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@agenticplatform.com

# LLM Provider
LLM_PROVIDER=openai  # Options: openai, anthropic, google, azure_openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TEMPERATURE=0.7

GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-pro
GOOGLE_TEMPERATURE=0.7

AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# Model Abstraction
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4-turbo-preview
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4000

# Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=/tmp/uploads

# File Storage
STORAGE_TYPE=local  # Options: local, s3, azure_blob
STORAGE_LOCAL_PATH=/tmp/uploads
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AZURE_BLOB_CONNECTION_STRING=your-connection-string

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:80

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# Session Settings
SESSION_TYPE=redis  # Options: memory, redis
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTP_ONLY=True
SESSION_COOKIE_SAMESITE=lax

# JWT Settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# MFA (Multi-Factor Authentication)
MFA_ENABLED=False
MFA_ISSUER=Agentic Platform

# SSO (Single Sign-On)
SSO_ENABLED=False
SSO_PROVIDER=google  # Options: google, azure-ad, okta
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback/google
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_REDIRECT_URI=http://localhost:8000/auth/callback/azure-ad

# SCIM (Provisioning)
SCIM_ENABLED=False
SCIM_URL=
SCIM_USERNAME=
SCIM_PASSWORD=

# Audit Logging
AUDIT_ENABLED=True
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_ENCRYPTED=False

# Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# RAG Settings
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=agentic-platform
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Document Processing
MAX_DOCUMENT_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/csv
PDF_EXTRACT_IMAGES=True
DOCX_PARSE_PARAGRAPHS=True

# Vector Store
VECTOR_STORE_TYPE=pinecone  # Options: pinecone, faiss, chroma
CHROMA_DATA_DIR=./data/chroma

# Workflow Engine
WORKFLOW_ENGINE=celery  # Options: celery, airflow
WORKFLOW_DEFAULT_TIMEOUT=300
WORKFLOW_MAX_RETRIES=3

# Action Engine
ACTION_DEFAULT_TIMEOUT=60
ACTION_MAX_RETRIES=3
ACTION_IDEMPOTENCY_ENABLED=True

# Approval Engine
APPROVAL_LOW_RISK_THRESHOLD=0
APPROVAL_MEDIUM_RISK_THRESHOLD=1000
APPROVAL_HIGH_RISK_THRESHOLD=10000

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-platform
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Prometheus
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=True
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# Email Notifications
EMAIL_NOTIFICATIONS_ENABLED=True
EMAIL_NOTIFICATION_FROM=noreply@agenticplatform.com

# Webhook
WEBHOOK_ENABLED=True
WEBHOOK_URL=

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# API Versioning
API_VERSION=v1
API_PREFIX=/api

# Health Check
HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_INTERVAL=30

# Background Tasks
BATCH_SIZE=100
MAX_WORKERS=4
TASK_TIMEOUT=3600

# Error Handling
SHOW_ERRORS_IN_BROWSER=True
LOG_ERRORS_TO_FILE=True
ERROR_LOG_FILE_PATH=./logs/error.log

# Data Retention
DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=365
SESSION_LOG_RETENTION_DAYS=90

# Feature Flags
FEATURE_FLAG_AGENT_AUTOMATION=True
FEATURE_FLAG_APPROVAL_WORKFLOW=True
FEATURE_FLAG_RAG_ENABLED=True
FEATURE_FLAG_ANALYTICS=True
FEATURE_FLAG_BILLING=True
